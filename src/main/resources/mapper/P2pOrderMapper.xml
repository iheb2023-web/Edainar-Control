<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.edinar.control.mapper.P2pOrderMapper">

    <resultMap id="P2pOrderResultMap" type="com.edinar.control.domain.P2pOrder">
        <id property="id" column="id"/>
        <result property="tradeId" column="trade_id"/>
        <result property="cardId" column="card_id"/>
        <result property="binanceOrderId" column="binance_order_id"/>
        <result property="side" column="side"/>
        <result property="role" column="role"/>
        <result property="asset" column="asset"/>
        <result property="quoteCurrency" column="quote_currency"/>
        <result property="quantityUsdt" column="quantity_usdt"/>
        <result property="unitPriceTnd" column="unit_price_tnd"/>
        <result property="grossAmountTnd" column="gross_amount_tnd"/>
        <result property="binanceFeeUsdt" column="binance_fee_usdt"/>
        <result property="binanceFeeTnd" column="binance_fee_tnd"/>
        <result property="feeConversionRate" column="fee_conversion_rate"/>
        <result property="status" column="status"/>
        <result property="notes" column="notes"/>
        <result property="orderDate" column="order_date"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO p2p_orders (
            trade_id, card_id, binance_order_id,
            side, role, asset, quote_currency,
            quantity_usdt, unit_price_tnd, gross_amount_tnd,
            binance_fee_usdt, binance_fee_tnd, fee_conversion_rate,
            status, order_date, notes, created_at
        ) VALUES (
            #{tradeId}, #{cardId}, #{binanceOrderId},
            #{side}, #{role}, #{asset}, #{quoteCurrency},
            #{quantityUsdt}, #{unitPriceTnd}, #{grossAmountTnd},
            #{binanceFeeUsdt}, #{binanceFeeTnd}, #{feeConversionRate},
            #{status}, #{orderDate}, #{notes}, #{createdAt}
        )
    </insert>

    <select id="findById" resultMap="P2pOrderResultMap">
        SELECT * FROM p2p_orders WHERE id = #{id}
    </select>

    <select id="findByTradeId" resultMap="P2pOrderResultMap">
        SELECT * FROM p2p_orders
        WHERE trade_id = #{tradeId}
        ORDER BY order_date ASC, id ASC
    </select>

</mapper>
