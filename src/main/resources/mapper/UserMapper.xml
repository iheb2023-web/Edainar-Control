<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.edinar.control.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.edinar.control.domain.User">
        <id property="id" column="id" typeHandler="com.edinar.control.config.UuidTypeHandler"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="displayName" column="display_name"/>
        <result property="status" column="status"/>
        <result property="timezone" column="timezone"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO users (
            id,
            email,
            password_hash,
            display_name,
            status,
            timezone,
            created_at,
            updated_at
        ) VALUES (
            #{id, typeHandler=com.edinar.control.config.UuidTypeHandler},
            #{email},
            #{passwordHash},
            #{displayName},
            #{status},
            #{timezone},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="findById" resultMap="UserResultMap">
        SELECT *
        FROM users
        WHERE id = #{id, typeHandler=com.edinar.control.config.UuidTypeHandler}
    </select>

    <select id="findFirst" resultMap="UserResultMap">
        SELECT *
        FROM users
        ORDER BY created_at ASC
        LIMIT 1
    </select>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT *
        FROM users
        WHERE email = #{email}
    </select>

    <update id="updatePassword">
        UPDATE users
        SET password_hash = #{passwordHash}, updated_at = #{updatedAt}
        WHERE id = #{id, typeHandler=com.edinar.control.config.UuidTypeHandler}
    </update>

    <update id="updateEmail">
        UPDATE users
        SET email = #{email}, updated_at = #{updatedAt}
        WHERE id = #{id, typeHandler=com.edinar.control.config.UuidTypeHandler}
    </update>

</mapper>
